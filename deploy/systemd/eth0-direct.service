[Unit]
Description=Configure eth0 direct link for workstation WOL
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/eth0-direct
ExecStart=/sbin/ip link set ${DIRECT_INTERFACE} up
ExecStart=/sbin/ip addr replace ${DIRECT_ADDRESS} dev ${DIRECT_INTERFACE}

[Install]
WantedBy=multi-user.target
