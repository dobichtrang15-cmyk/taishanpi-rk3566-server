page {
  background: #f4f6f8;
  color: #1f2937;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.input,
.textarea {
  width: 100%;
  background: #f8fafc;
  border: 1rpx solid #e6eaef;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 240rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.btn-row button {
  flex: 1;
  min-width: 220rpx;
}

.primary {
  background: #2563eb !important;
  color: #ffffff !important;
}

.danger {
  background: #dc2626 !important;
  color: #ffffff !important;
}

.pill {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.pill-ok {
  background: #f0fdf4;
  color: #16a34a;
}

.pill-warn {
  background: #fff7ed;
  color: #d97706;
}

.pill-danger {
  background: #fef2f2;
  color: #dc2626;
}

.kv {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2f6;
}

.kv:first-child {
  border-top: 0;
}

.kv-key {
  color: #6b7280;
}

.kv-value {
  text-align: right;
  word-break: break-all;
}

.list-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #eef2f6;
}

.list-item:first-child {
  border-top: 0;
}

.list-name {
  font-weight: 600;
}

.list-meta {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.status-error {
  color: #dc2626;
  margin-top: 12rpx;
}

.status-ok {
  color: #16a34a;
  margin-top: 12rpx;
}

.hero-card {
  padding: 30rpx 28rpx;
  background:
    radial-gradient(circle at top right, rgba(37, 99, 235, 0.12), transparent 34%),
    #ffffff;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 44rpx;
  line-height: 1.22;
  font-weight: 800;
  color: #0f172a;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.dashboard-panel {
  padding-top: 26rpx;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.dashboard-card {
  position: relative;
  padding: 22rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at top right, rgba(37, 99, 235, 0.08), transparent 34%),
    linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  border: 1rpx solid #e7edf4;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.dashboard-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 8rpx;
  border-radius: 999rpx;
  background: #cbd5e1;
}

.dashboard-card-ok::before {
  background: #16a34a;
}

.dashboard-card-warn::before {
  background: #d97706;
}

.dashboard-card-info::before {
  background: #2563eb;
}

.dashboard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dashboard-label {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 1rpx;
}

.dashboard-badge {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.dashboard-badge-ok {
  background: #f0fdf4;
  color: #16a34a;
}

.dashboard-badge-warn {
  background: #fff7ed;
  color: #d97706;
}

.dashboard-badge-info {
  background: #eff6ff;
  color: #2563eb;
}

.dashboard-meter {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
}

.dashboard-meter-stack {
  display: block;
}

.dashboard-ring {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  border: 7rpx solid #cbd5e1;
  box-sizing: border-box;
  box-shadow: 0 0 0 6rpx rgba(148, 163, 184, 0.08);
}

.dashboard-ring-ok {
  border-color: #16a34a;
  box-shadow: 0 0 0 8rpx rgba(22, 163, 74, 0.12);
}

.dashboard-ring-warn {
  border-color: #d97706;
  box-shadow: 0 0 0 8rpx rgba(217, 119, 6, 0.12);
}

.dashboard-reading {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 0.5rpx;
}

.dashboard-reading-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.dashboard-desc {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.6;
}

.stat-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 22rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

.stat-value {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #111827;
}

.stat-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.6;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.action-tile {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 180rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e6eaef;
  box-sizing: border-box;
}

.action-tile-primary {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border-color: #cfe0ff;
}

.action-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.action-note {
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.toolbar-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.toolbar-row button {
  flex: 1;
  min-width: 180rpx;
}

.soft-button {
  background: #ffffff !important;
  color: #1f2937 !important;
  border: 1rpx solid #e6eaef !important;
}

.mono {
  font-family: "SFMono-Regular", Consolas, Monaco, monospace;
}

.muted {
  color: #64748b;
  font-size: 22rpx;
}

.file-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.file-row-main {
  flex: 1;
  min-width: 0;
}

.file-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 150rpx;
}

.empty-note {
  text-align: center;
  color: #64748b;
  font-size: 24rpx;
  padding: 36rpx 0 12rpx;
}

.action-tile::after,
.action-grid::after,
.toolbar-row::after,
.card::after {
  border: 0;
}

.component-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.component-card {
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  border: 1rpx solid #e7edf4;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
}

.component-card-primary {
  background: linear-gradient(180deg, #ffffff 0%, #eff6ff 100%);
  border-color: #cfe0ff;
}

.component-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.component-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.component-tag {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 700;
}

.component-tag-danger {
  background: #fef2f2;
  color: #dc2626;
}

.component-desc {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.6;
}

.component-foot {
  margin-top: 16rpx;
  color: #94a3b8;
  font-size: 21rpx;
}

.component-subcard {
  margin-bottom: 16rpx;
  padding: 22rpx;
}

.component-subcard:last-child {
  margin-bottom: 0;
}

.list-shell {
  border: 1rpx solid #e7edf4;
  border-radius: 24rpx;
  overflow: hidden;
  background: #ffffff;
}

.list-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: #f8fafc;
  border-bottom: 1rpx solid #edf2f7;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}

.list-head-main {
  flex: 1;
}

.list-head-type {
  width: 120rpx;
  text-align: center;
}

.list-head-actions {
  width: 152rpx;
  text-align: center;
}

.list-row {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 18rpx 24rpx;
  border-top: 1rpx solid #edf2f7;
}

.list-row:first-child {
  border-top: 0;
}

.list-row-main {
  flex: 1;
  min-width: 0;
}

.list-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.list-row-title {
  min-width: 0;
  font-size: 27rpx;
  font-weight: 700;
  color: #0f172a;
  word-break: break-all;
}

.list-row-type-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
}

.list-row-type {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 20rpx;
  font-weight: 700;
}

.list-row-path {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
  word-break: break-all;
}

.list-row-meta {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.list-row-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  width: 152rpx;
}

.file-summary-card {
  display: flex;
  gap: 18rpx;
  align-items: stretch;
}

.file-summary-item {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #edf2f7;
}

.file-summary-label {
  font-size: 22rpx;
  color: #64748b;
}

.file-summary-value {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  word-break: break-all;
}
