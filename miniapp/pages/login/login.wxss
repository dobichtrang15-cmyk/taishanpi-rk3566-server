.login-page {
  padding: 0;
  background:
    radial-gradient(circle at top left, rgba(37, 99, 235, 0.14), transparent 34%),
    linear-gradient(180deg, #eef4ff 0%, #f5f7fb 46%, #f5f7fb 100%);
}

.login-shell {
  min-height: 100vh;
  padding: 48rpx 28rpx 36rpx;
  box-sizing: border-box;
}

.login-hero {
  margin-bottom: 28rpx;
}

.login-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.login-title {
  margin-top: 24rpx;
  font-size: 52rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #0f172a;
}

.login-subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #64748b;
}

.login-panel {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 28rpx;
  padding: 30rpx 26rpx 28rpx;
  box-shadow: 0 22rpx 56rpx rgba(15, 23, 42, 0.08);
}

.login-panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 22rpx;
}

.login-group {
  margin-bottom: 22rpx;
}

.login-label {
  display: block;
  margin-bottom: 12rpx;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
}

.login-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe3ee;
  font-size: 28rpx;
  color: #111827;
}

.login-placeholder {
  color: #9aa4b2;
  font-size: 26rpx;
}

.login-submit {
  margin-top: 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #2563eb, #2f6df3);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.login-error {
  margin-top: 16rpx;
}

.login-tip {
  margin-top: 24rpx;
  padding: 0 6rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.8;
}
